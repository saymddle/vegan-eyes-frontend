{
  "expo": {
    "name": "Vegan Eyes",
    "slug": "vegan-eyes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "veganeyes",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF7E8",
    "ios": {
      "bundleIdentifier": "app.veganeyes",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.veganeyes",
      "adaptiveIcon": {
        "backgroundColor": "#214E34",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#214E34",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Vegan Eyes uses the camera to read ingredient lists, recipes and barcodes so it can tell you what isn't vegan.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vegan Eyes opens the photo you pick so it can read the ingredients or recipe in it."
        }
      ],
      "expo-sqlite",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

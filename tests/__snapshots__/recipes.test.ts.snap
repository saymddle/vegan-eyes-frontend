exports[`recipes convert to vegan > 06-ocr-markdown.txt > matches the saved vegan version 1`] = `
"Chicken Alfredo
Ingredients
2 seitan cutlets
1 cup full-fat coconut cream
1/2 cup vegan parmesan
2 tbsp vegan butter
12 oz fettuccine
Instructions
1. Season and cook the seitan until golden, then slice.
2. Melt the vegan butter, add the full-fat coconut cream and simmer for 5 minutes.
3. Stir in the vegan parmesan and toss with the fettuccine and seitan."
`;

